# Shopify Admin API access token (used by push script)
# This is filled after running: npm run auth:token
SHOPIFY_ACCESS_TOKEN=

# OAuth app credentials from Shopify Dev Dashboard > Product Pusher > Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Local callback used by the token helper script
SHOPIFY_REDIRECT_URI=http://127.0.0.1:3456/callback

# Embedded shell OAuth callback (Phase B).
# For a hosted deployment (e.g. Render), set this to your public https URL instead, e.g.:
#   EMBEDDED_SHOPIFY_REDIRECT_URI=https://yourapp.onrender.com/auth/callback
# and register the same URL as an allowed redirect in your Shopify app settings.
EMBEDDED_SHOPIFY_REDIRECT_URI=http://127.0.0.1:4320/auth/callback

# Local UI port. Leave unset on hosting platforms that inject PORT automatically (e.g. Render) —
# the server already falls back to process.env.PORT.
EMBEDDED_UI_PORT=4320

# Set true to allow the embedded app to create/update real Shopify drafts.
EMBEDDED_ALLOW_LIVE_PUSH=true

# Optional HTTP Basic Auth gate for shared/hosted deployments. Leave both blank to disable
# (fine for local solo dev). Set both to require login on a hosted instance — this is what
# the agency team will use to sign in.
EMBEDDED_APP_USERNAME=
EMBEDDED_APP_PASSWORD=

# OAuth scopes requested during token generation.
# Inventory/location scopes are required for default location lookup and quantity writes.
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations

# Optional explicit token-store encryption key.
# If omitted, token encryption falls back to SHOPIFY_CLIENT_SECRET.
SHOPIFY_AUTH_ENCRYPTION_KEY=

# Optional comma-separated previous keys for decrypting older rotated entries.
SHOPIFY_AUTH_ENCRYPTION_OLD_KEYS=

# Your Shopify store domain, no protocol.
# Example: your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin GraphQL API version
SHOPIFY_API_VERSION=2025-10

# Shopify API retry policy (C1-03)
SHOPIFY_API_MAX_RETRIES=5
SHOPIFY_API_RETRY_BASE_MS=500
SHOPIFY_API_RETRY_MAX_MS=8000
SHOPIFY_CREATE_RECOVERY_RETRIES=3

# Set true to log request payloads for debugging
DEBUG=false

# ─── AI Provider ────────────────────────────────────────────────────────────
# "gemini" (free tier) or "openai" (paid). Only the key for the active provider is required.
AI_PROVIDER=gemini

# Gemini — get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_COPY_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI — only needed if AI_PROVIDER=openai
OPENAI_API_KEY=
